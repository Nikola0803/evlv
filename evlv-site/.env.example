# Copy to .env.local (gitignored) and fill in real values.

# Trustpilot mini-carousel widget on the homepage. This is the Business Unit
# ID from Trustpilot Business App > Widgets > Mini Carousel (NOT your domain)
# for evlvpeptides.com. Until this is set, the widget renders nothing.
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=

# Account sign-in/create-account (AgeGate + future /account pages), backed by
# the custom CRM at C:\Users\PC\Desktop\peptides-crm-app. Server-only -- never
# prefix these with NEXT_PUBLIC_, the API key must not reach the browser.
#   CRM_API_URL      — where peptides-crm-app is deployed, e.g. https://crm.example.com
#   CRM_ORG_API_KEY  — your Organization.apiKey from the CRM's Settings/Webhooks page
#   CRM_STORE_DOMAIN — the domain the EVLV Brand row is registered under in the CRM (e.g. evlvpeptides.com)
CRM_API_URL=
CRM_ORG_API_KEY=
CRM_STORE_DOMAIN=

# Newsletter/contact (src/components/layout/NewsletterForm.tsx and
# src/app/contact/ContactForm.tsx) both route through the same CRM_API_URL/
# CRM_ORG_API_KEY/CRM_STORE_DOMAIN above -- no extra keys needed. Contact
# form submissions land as a SupportTicket, newsletter signups land as a
# Contact and get pushed to Mailchimp (see peptides-crm-app's MAILCHIMP_*
# env vars) best-effort.
