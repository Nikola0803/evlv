# Copy to .env.local (gitignored) and fill in real values.

# GA4 (Google Analytics). Get this from Google Analytics > Admin > Data
# Streams > (your stream) > Measurement ID. Renders nothing until set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager container ID (from tagmanager.google.com). Renders
# nothing until set.
NEXT_PUBLIC_GTM_ID=

# Google reviews widget on the homepage (replaced Trustpilot). GOOGLE_PLACE_ID
# is EVLV's Google Business Profile place ID -- find it at
# https://developers.google.com/maps/documentation/places/web-service/place-id
# GOOGLE_PLACES_API_KEY is a Places API key from Google Cloud Console,
# restricted to the Places API. Server-only. Until both are set, the widget
# renders an honest empty state instead of fake reviews.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Account sign-in/create-account (AgeGate + future /account pages), backed by
# the custom CRM at C:\Users\PC\Desktop\peptides-crm-app. Server-only -- never
# prefix these with NEXT_PUBLIC_, the API key must not reach the browser.
#   CRM_API_URL      — where peptides-crm-app is deployed, e.g. https://crm.example.com
#   CRM_ORG_API_KEY  — your Organization.apiKey from the CRM's Settings/Webhooks page
#   CRM_STORE_DOMAIN — the domain the EVLV Brand row is registered under in the CRM (e.g. evlvpeptides.com)
CRM_API_URL=
CRM_ORG_API_KEY=
CRM_STORE_DOMAIN=

# Newsletter signups (src/components/layout/NewsletterForm.tsx) route
# through the same CRM_API_URL/CRM_ORG_API_KEY/CRM_STORE_DOMAIN above --
# lands as a Contact with marketingOptIn=true and gets pushed to Mailchimp
# best-effort (see the CRM's MAILCHIMP_API_KEY/MAILCHIMP_LIST_ID env vars).
#
# The contact form (src/app/contact/ContactForm.tsx) is separate: it uses
# the CRM's per-brand tracking-pixel key, not the store-domain/api-key
# pair, because /api/forms/submit is meant to be callable straight from a
# browser. Get this value by running prisma/seed-evlv.ts in the CRM (it
# upserts a TrackingConfig row and prints `CRM_CONTACT_FORM_KEY=...`).
CRM_CONTACT_FORM_KEY=

# Analytics pixel (src/app/layout.tsx embeds the CRM's /pixel.js, fires
# page_view automatically; order-success fires a purchase event). Unlike
# the vars above, these ARE meant to reach the browser -- NEXT_PUBLIC_
# is required, and this is the same publicKey as CRM_CONTACT_FORM_KEY
# above (it's already documented as safe client-side on the CRM's end).
# Without these two set, the pixel script just doesn't render -- nothing
# breaks, no events are sent.
NEXT_PUBLIC_CRM_URL=
NEXT_PUBLIC_CRM_TRACKING_KEY=
