@@ -0,0 +1,60 @@
+"use client";
+
+import { useState, useTransition } from "react";
+import { fixEmailFooters, type FooterFixResult } from "./actions";
+
+export function FixEmailFootersButton() {
+  const [pending, startTransition] = useTransition();
+  const [result, setResult] = useState<FooterFixResult | null>(null);
+  const [error, setError] = useState("");
+
+  function run() {
+    setError("");
+    startTransition(() => {
+      fixEmailFooters()
+        .then((r) => setResult(r))
+        .catch((err) => setError(err instanceof Error ? err.message : "Something went wrong."));
+    });
+  }
+
+  return (
+    <div>
+      <button
+        type="button"
+        onClick={run}
+        disabled={pending}
+        className="rounded-md bg-primary-500 px-4 py-2 text-sm font-medium text-background-50 hover:bg-primary-600 disabled:cursor-wait disabled:opacity-60"
+      >
+        {pending ? "Fixing..." : "Fix footer links & address"}
+      </button>
+
+      {error && <p className="mt-3 text-sm text-red-600">{error}</p>}
+
+      {result && (
+        <div className="mt-4 space-y-2">
+          {result.fixed.length > 0 ? (
+            <div>
+              <p className="text-sm font-medium text-foreground-800">Fixed {result.fixed.length} template(s):</p>
+              <ul className="mt-1 list-disc pl-5 text-xs text-foreground-600">
+                {result.fixed.map((f) => (
+                  <li key={f.key}>{f.name}</li>
+                ))}
+              </ul>
+              <p className="mt-2 text-xs text-foreground-500">
+                Unsubscribe / Update Email Preferences links now point at a real, working link for whoever the email
+                is sent to. The mailing address placeholder was replaced with a placeholder Boise, ID address --
+                swap it for the business&rsquo;s real filing address when you have it (CAN-SPAM requires a genuine
+                postal address in bulk email).
+              </p>
+            </div>
+          ) : (
+            <p className="text-sm text-foreground-600">Nothing to fix -- no template had that footer.</p>
+          )}
+          {result.alreadyOk.length > 0 && (
+            <p className="text-xs text-foreground-400">Already fine (skipped): {result.alreadyOk.join(", ")}</p>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/src/app/(app)/email-marketing/actions.ts b/src/app/(app)/email-marketing/actions.ts
