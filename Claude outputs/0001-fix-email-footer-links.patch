--- a/src/lib/email.ts
+++ b/src/lib/email.ts
@@ -530,5 +530,74 @@ export async function getTemplate(organizationId: string, key: string): Promise<
 
 export async function sendTemplate(organizationId: string, key: string, to: string, vars: Record<string, string>): Promise<void> {
   const { subject, html } = await getTemplate(organizationId, key);
-  await sendEmail(to, renderTemplate(subject, vars), renderTemplate(html, vars));
+  const unsubscribeUrl = await buildUnsubscribeUrl(organizationId, to);
+  const mergedVars = { unsubscribeUrl, updateEmailPreferencesUrl: unsubscribeUrl, ...vars };
+  await sendEmail(to, renderTemplate(subject, mergedVars), renderTemplate(html, mergedVars));
+}
+
+// Every hand-designed template row (see the Email page's per-key editor)
+// gets pasted in with its own baked "Unsubscribe / Update Email
+// Preferences" footer copied from whatever design tool made it -- those
+// links are dead until something fills in {{unsubscribeUrl}}, which is
+// exactly what fixFooterLinks() (below) rewrites them to point at. This
+// is what actually makes that link work: every sendTemplate() call looks
+// up the real contact + brand for `to` and signs a real token, the same
+// mechanism the in-house newsletter sender already used one-off (see
+// sendToAll() in email-marketing/newsletter/actions.ts). Falls back to
+// the brand's bare homepage (no token) when `to` isn't a known Contact
+// (e.g. an internal "office@" notify address), and to "" (dead link, but
+// at least doesn't crash the send) when this org has no Brand at all yet.
+async function buildUnsubscribeUrl(organizationId: string, to: string): Promise<string> {
+  const { getStorefrontUrl } = await import("./storefront-url");
+  const { signUnsubscribeToken } = await import("./customer-auth");
+
+  const contact = await prisma.contact.findUnique({
+    where: { organizationId_email: { organizationId, email: to } },
+  });
+  const brand = contact
+    ? (await prisma.contactBrandLink.findFirst({ where: { contactId: contact.id }, select: { brand: { select: { domain: true } } } }))?.brand
+    : await prisma.brand.findFirst({ where: { organizationId }, select: { domain: true } });
+  if (!brand?.domain) return "";
+
+  return contact
+    ? getStorefrontUrl(brand.domain, `/unsubscribe?token=${signUnsubscribeToken(contact.id)}`)
+    : getStorefrontUrl(brand.domain);
+}
+
+// One-time cleanup for the "cool designs" pasted into the Email page's
+// per-template editor by hand: they carry a CAN-SPAM-style footer copied
+// from whatever design tool made them, with a placeholder mailing address
+// and an Unsubscribe / Update Email Preferences link that goes nowhere
+// (href="#" or similar). This rewrites both, in place, across every
+// EmailTemplate row already saved for an org:
+//  - the bracketed placeholder address -> a real line (still worth
+//    double-checking against the business's actual filing address --
+//    CAN-SPAM requires a genuine postal address in bulk email)
+//  - whatever the Unsubscribe/Update-Preferences link's href currently is
+//    -> {{unsubscribeUrl}}, now a real merge var every sendTemplate()
+//    call fills in for real (see buildUnsubscribeUrl() above)
+// Doesn't touch DEFAULT_TEMPLATES (the code fallbacks) since none of
+// those ship with this footer baked in -- only rows a human pasted a
+// design into need this.
+export function fixFooterHtml(html: string): { html: string; changed: boolean } {
+  let out = html;
+  let changed = false;
+
+  const addressPattern = /\[Insert US Street Address,?\s*City,?\s*State,?\s*ZIP\]/gi;
+  if (addressPattern.test(out)) {
+    out = out.replace(addressPattern, "1109 W Idaho St, Boise, ID 83702");
+    changed = true;
+  }
+
+  // Rewrite the href of any <a> tag whose visible text is "Unsubscribe"
+  // or "Update Email Preferences" (Mailchimp/Klaviyo-style CAN-SPAM
+  // boilerplate), regardless of what it currently points at ("#", "",
+  // an absolute dead URL, whatever the design tool put there).
+  const linkPattern = /(<a\b[^>]*\bhref\s*=\s*)(["'])(.*?)\2([^>]*>\s*(?:Unsubscribe|Update Email Preferences)\s*<\/a>)/gi;
+  out = out.replace(linkPattern, (_m, pre, quote, _href, post) => {
+    changed = true;
+    return `${pre}${quote}{{unsubscribeUrl}}${quote}${post}`;
+  });
+
+  return { html: out, changed };
 }
