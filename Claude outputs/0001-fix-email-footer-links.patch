 import { revalidatePath } from "next/cache";
 import { requireOrg } from "@/lib/session";
 import { prisma } from "@/lib/prisma";
-import { DEFAULT_TEMPLATES, sendTemplate } from "@/lib/email";
+import { DEFAULT_TEMPLATES, sendTemplate, fixFooterHtml } from "@/lib/email";
+
+export interface FooterFixResult {
+  fixed: { key: string; name: string }[];
+  alreadyOk: string[];
+}
+
+// One-click cleanup for every hand-pasted template's CAN-SPAM footer --
+// see fixFooterHtml()'s doc comment in src/lib/email.ts for exactly what
+// this rewrites (placeholder mailing address, dead Unsubscribe/Update
+// Email Preferences links). Safe to run more than once: a row that's
+// already fixed (or never had this footer to begin with) is just skipped.
+export async function fixEmailFooters(): Promise<FooterFixResult> {
+  const { organization } = await requireOrg();
+  const rows = await prisma.emailTemplate.findMany({ where: { organizationId: organization.id } });
+
+  const result: FooterFixResult = { fixed: [], alreadyOk: [] };
+  for (const row of rows) {
+    const { html, changed } = fixFooterHtml(row.html);
+    if (!changed) {
+      result.alreadyOk.push(row.name);
+      continue;
+    }
+    await prisma.emailTemplate.update({ where: { id: row.id }, data: { html } });
+    result.fixed.push({ key: row.key, name: row.name });
+  }
+
+  revalidatePath("/email-marketing");
+  for (const f of result.fixed) revalidatePath(`/email-marketing/${f.key}`);
+  return result;
+}
 
